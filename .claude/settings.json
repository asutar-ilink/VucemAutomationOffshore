{
  "permissions": {
    "deny": [
      "Read(d:/VucemDev/**)",
      "Read(d:\\VucemDev\\**)",
      "Edit(d:/VucemDev/**)",
      "Write(d:/VucemDev/**)",
      "Edit(d:\\VucemDev\\**)",
      "Write(d:\\VucemDev\\**)"
    ],
    "allow": [
      "PowerShell(npx playwright test tests/cofepris/260204.spec.ts --headed)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-git-secret-scan.sh",
            "if": "Bash(git *)",
            "statusMessage": "Scanning for secrets before git commit/push"
          }
        ]
      }
    ]
  }
}

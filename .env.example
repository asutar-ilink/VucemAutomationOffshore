# Azure DevOps config for scripts/fetch-testcases.py (npm run fetch).
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# NEVER commit it: ADO_PAT is a secret.

ADO_ORGANIZATION=VUCEM
ADO_PROJECT=VUCEM 3.0 Phase 2

# Personal Access Token with "Test Management (Read)" + "Work Items (Read)" scope.
ADO_PAT=your-azure-devops-pat-here

# Default plan/suite. Override per run with: npm run fetch -- <proc> --plan N --suite M
TEST_PLAN_ID=29
TEST_SUITE_ID=18033

# Where <procedure>.json is written. Defaults to manual-testcases/ if unset.
OUTPUT_FOLDER=manual-testcases

# Optional fallback if you run `npm run fetch` with no procedure argument.
PROCEDURE_NUMBER=

# Normalize line endings so Windows/macOS/Linux checkouts match and git stops
# warning about LF↔CRLF conversion. Text files are stored (and checked out) LF.
* text=auto eol=lf

# Shell scripts and git hooks MUST stay LF or they won't execute on Unix.
*.sh text eol=lf
.githooks/* text eol=lf

# Binary assets — never touch line endings.
*.pdf binary
*.cer binary
*.key binary
*.pfx binary
*.p12 binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
